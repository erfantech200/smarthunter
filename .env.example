# Trade Desk environment. Copy to .env (`make up` does this on first run) and fill in.
# Secrets live ONLY here — never in code, config/desk.yaml or logs. .env is git-ignored.

# --- Runtime -------------------------------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
# Comma-separated adapters running in mock mode. MUST be empty in production (the app refuses to start).
MOCK_ADAPTERS=

# --- Storage (docker compose builds DATABASE_URL/REDIS_URL from these) ------------------------
POSTGRES_PASSWORD=change-me-locally
# For running the backend on the host instead of in compose:
DATABASE_URL=postgresql+asyncpg://desk:change-me-locally@localhost:5432/desk
REDIS_URL=redis://localhost:6379/0

# --- App security ----------------------------------------------------------------------------
# Signs expiring "I took it" deep links (Phase 3). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- LLM (Phase 5) — https://console.anthropic.com → API keys. Paid, usage-based. -----------------
ANTHROPIC_API_KEY=

# --- Prices (Phase 1) — recommended primary feed, see docs/PROVIDERS.md --------------------------
# OANDA practice (demo) account → My Account → Manage API Access → generate token. Free.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice     # practice | live (read-only pricing use only; NO order endpoints are ever called)
# Cross-check source (free Basic tier is enough for a 1-instrument cross-check): twelvedata.com
TWELVE_DATA_API_KEY=

# --- Macro / energy / positioning (Phase 1, 6) — all free, official ------------------------------
FRED_API_KEY=                  # fredaccount.stlouisfed.org → API keys
EIA_API_KEY=                   # eia.gov/opendata → register
CFTC_SOCRATA_APP_TOKEN=        # optional; publicreporting.cftc.gov → sign up → developer settings (raises rate limit)

# --- Calendar / news (Phase 5, 6) — paid tier needed for consensus; see docs/PROVIDERS.md ---------
FMP_API_KEY=
FINNHUB_API_KEY=

# --- Notifications (Phase 3, 9) ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # @BotFather → /newbot
TELEGRAM_CHAT_ID=              # the bot answers ONLY this chat id
